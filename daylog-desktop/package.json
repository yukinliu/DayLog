{
  "name": "daylog-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run build && npm run test:rust",
    "release:check": "node scripts/release-check.mjs && npm run check",
    "test:rust": "PATH=$HOME/.cargo/bin:$PATH cargo test --manifest-path src-tauri/Cargo.toml",
    "preview": "vite preview",
    "tauri": "PATH=$HOME/.cargo/bin:$PATH tauri",
    "tauri:dev": "PATH=$HOME/.cargo/bin:$PATH tauri dev",
    "tauri:build": "PATH=$HOME/.cargo/bin:$PATH tauri build",
    "release:macos": "bash scripts/build-macos-dmg.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
